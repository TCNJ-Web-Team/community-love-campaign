import "../styles/accordion-styles.scss";
import Header from "../components/Header";
import CarouselContainer from "../components/CarouselContainer";
import VideoComponent from "../components/VideoComponent";
import CustomVideo from "../components/CustomVideo";
import Accodion from "../components/Accordion";

import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer";
import GiveBanner from "../components/GiveBanner";
// import TopTakeoverBar from "../components/TopTakeoverBar";
import "@fontsource/domine/400.css";
import "@fontsource/domine/600.css";
import "@fontsource/raleway/400.css";
import "@fontsource/raleway/500.css";
